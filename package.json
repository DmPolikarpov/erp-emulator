{
  "name": "erp-simulator",
  "version": "1.0.0",
  "private": true,
  "proxy": "http://localhost:8080",
  "dependencies": {
    "@bpmn-io/properties-panel": "^3.56.1",
    "bpmn-js": "^17.11.1",
    "bpmn-js-properties-panel": "^5.65.1",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false",
    "sdk:build": "node src/bpmn-sdk/tools/build.mjs",
    "sdk:sync": "node src/bpmn-sdk/tools/sync.mjs",
    "sdk:verify": "node src/bpmn-sdk/tools/verify.mjs",
    "sdk:refresh": "npm run sdk:build && npm run sdk:sync && npm run sdk:verify",
    "sdk:demo": "node src/bpmn-sdk/tools/sync.mjs --demo",
    "sdk:demo:clean": "node src/bpmn-sdk/tools/sync.mjs --clean-demo"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3"
  }
}
